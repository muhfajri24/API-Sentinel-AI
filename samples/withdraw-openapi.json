{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic Wallet API",
    "version": "0.1"
  },
  "paths": {
    "/withdraw": {
      "post": {
        "summary": "Withdraw synthetic units from a synthetic balance",
        "description": "Business rule: amount > balance must be rejected with HTTP 422 and approved=false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "balance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "balance",
                  "amount"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Withdrawal accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approved": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "remaining": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "approved"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Withdrawal rejected due to invalid amount or insufficient funds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approved": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "remaining": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "approved"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
