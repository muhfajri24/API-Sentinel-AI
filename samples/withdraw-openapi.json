{
  "openapi": "3.1.0",
  "info": {"title": "Synthetic Wallet API", "version": "0.1"},
  "paths": {
    "/withdraw": {
      "post": {
        "summary": "Withdraw synthetic units from a synthetic balance",
        "description": "Business rule: amount > balance must be rejected with HTTP 422 and approved=false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"balance": {"type": "integer"}, "amount": {"type": "integer"}},
                "required": ["balance", "amount"]
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Withdrawal accepted"},
          "422": {"description": "Withdrawal rejected due to invalid amount or insufficient funds"}
        }
      }
    }
  }
}
